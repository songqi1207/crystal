# Database (SQLite for local dev; path is relative to packages/db/prisma/)
DATABASE_URL="file:./dev.db"

# HMAC-signing secret for Phase 1 certificates AND the SIWE nonce cookie.
# Rotate to invalidate all signatures and in-flight wallet logins.
ASTRAYA_SIGNING_SECRET="change-me-to-a-long-random-string"

# Session/email-login secret and encryption key for super-admin TOTP secrets.
# Production refuses the development fallback. Rotating this value requires
# all super administrators to enroll MFA again.
ASTRAYA_AUTH_SECRET="change-me-to-another-long-random-string"

# Email delivery. `resend` performs real delivery in every environment and is
# the default. Use `console` only for explicit local/offline development; it is
# rejected in production and is the only mode that returns a debug code.
ASTRAYA_EMAIL_MODE="resend"
RESEND_API_KEY=""
ASTRAYA_EMAIL_FROM="Astraya <login@send.your-domain.com>"

# ----------------------------------------------------------------------------
# Phase 2 · wallet login (leave empty until ENABLE_WEB3=true)
# ----------------------------------------------------------------------------

# Feature flag. When "true", /my renders the RainbowKit connect + bind panel.
NEXT_PUBLIC_ENABLE_WEB3="false"

# Which chain the UI targets. Supported: base-sepolia | base | hardhat.
NEXT_PUBLIC_CHAIN="base-sepolia"

# Deployed contract addresses (see packages/contracts/README.md). When empty,
# the "铸造为链上 NFT" button in /my renders disabled with a hint.
NEXT_PUBLIC_CERTIFICATE_CONTRACT=""
NEXT_PUBLIC_DIVINATION_CONTRACT=""

# WalletConnect Cloud project id. Required for WalletConnect v2 relay
# (MetaMask injected + Coinbase Wallet injected work without it).
# Get one free at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Public RPC — defaults to https://sepolia.base.org / https://mainnet.base.org.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=""
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=""

# Site URL — used as the SIWE domain/URI. Must match the actual origin the
# browser uses, otherwise SIWE.verify will reject the message.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
