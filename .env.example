# ----------------------------------------------------------------------------
# Astraya — environment variables (copy to .env and fill as needed)
# ----------------------------------------------------------------------------

# Database (Phase 1 uses SQLite locally; Phase 2 swap to Postgres URL)
DATABASE_URL="file:./dev.db"

# Astraya certificate signing secret (used to hash PDF certs — NEVER commit the real one)
ASTRAYA_CERT_SECRET="change-me-to-a-long-random-string"
# Also encrypts super-admin TOTP secrets. Back it up securely; rotating it
# requires all super administrators to enroll MFA again.
ASTRAYA_AUTH_SECRET="change-me-to-another-long-random-string"
RESEND_API_KEY=""
ASTRAYA_EMAIL_MODE="resend"
ASTRAYA_EMAIL_FROM="Astraya <login@send.your-domain.com>"

# Public site config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="zh"
NEXT_PUBLIC_ENABLE_WEB3="false"

# ----------------------------------------------------------------------------
# Payments — Phase 1 placeholders (empty = payment UI shows "coming soon")
# ----------------------------------------------------------------------------

# Stripe (SEA / overseas edition)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# WeChat Pay / Alipay (mainland edition — populated when co-op entity onboards)
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""

# ----------------------------------------------------------------------------
# Auth (Phase 1)
# ----------------------------------------------------------------------------

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# ----------------------------------------------------------------------------
# Phase 2 — Web3 (leave empty until we flip NEXT_PUBLIC_ENABLE_WEB3=true)
# ----------------------------------------------------------------------------

NEXT_PUBLIC_CHAIN="base-sepolia"                   # base | base-sepolia | hardhat
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=""
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=""
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""            # WalletConnect Cloud projectId (M2)

# M2 — SIWE nonce HMAC secret (rotate if you suspect compromise)
ASTRAYA_SIGNING_SECRET="change-me-to-a-long-random-string"

# M3 — on-chain mint (fill after running contracts deploy on Base Sepolia)
NEXT_PUBLIC_CERTIFICATE_CONTRACT=""                # 0x… AstrayaCertificate721 address
NEXT_PUBLIC_DIVINATION_CONTRACT=""                 # 0x… AstrayaDivination721 address
NEXT_PUBLIC_ESCROW_CONTRACT=""                     # reserved for Phase 2 · M4 (USDC)

# Private key (32-byte hex, with or without 0x prefix) that was granted MINTER_ROLE
# on the certificate/divination contracts at deploy time. Server-side only —
# NEVER commit a real key and NEVER prefix with NEXT_PUBLIC_.
ASTRAYA_MINTER_PRIVATE_KEY=""

PRIVY_APP_ID=""
