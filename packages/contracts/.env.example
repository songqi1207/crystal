# ----------------------------------------------------------------------------
# Astraya Contracts — deployment / verification env (never commit real values)
# ----------------------------------------------------------------------------

# Hex private key of the deployer wallet. MUST hold some Base Sepolia ETH
# (get some from https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet).
DEPLOYER_PRIVATE_KEY=""

# Optional custom RPC URLs. Default: public endpoints.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_MAINNET_RPC_URL="https://mainnet.base.org"

# BaseScan API key for source verification (both sepolia & mainnet).
# Grab one at https://basescan.org/myapikey
BASESCAN_API_KEY=""

# Set 1/true to enable gas reporter during `pnpm test:gas`.
REPORT_GAS=""

# Default royalty configuration (wired into deploy.ts). Receiver must be the
# platform treasury multisig; feeNumerator is in EIP-2981 basis points
# (500 = 5%).
ROYALTY_RECEIVER=""
ROYALTY_FEE_BPS="500"

# Default MINTER address granted MINTER_ROLE after deployment. Typically the
# web app's signer (ASTRAYA_MINTER_PRIVATE_KEY on the apps/web side). If
# empty, deployer keeps MINTER_ROLE and you must grant it later.
INITIAL_MINTER=""
